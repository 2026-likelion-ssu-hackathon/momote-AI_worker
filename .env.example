# 이 파일을 .env 로 복사해서 값을 채운다.
OPENAI_API_KEY=sk-...

# 판정 · 생성에 쓰는 모델. init_chat_model 형식("provider:model")
KAKAPO_MODEL=openai:gpt-4.1-mini

# 비워두면 temperature 를 아예 넘기지 않는다 (reasoning 모델 대응)
KAKAPO_TEMPERATURE=0.3

# 기억 임베딩 모델
KAKAPO_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# 외부 API — 없으면 해당 기능만 조용히 미발동한다 (워커는 죽지 않는다)
# ---------------------------------------------------------------------------

# 데이트 코스 추천 — 카카오 로컬 API (장소 검색 + place_url)
#   https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
#   무료, 일 100,000회. 카카오 로그인 설정은 필요 없다.
#   ⚠️ 키 발급만으로는 안 된다. 앱에서 **카카오맵 서비스를 켜야** 한다:
#      앱 설정 → 플랫폼 → Web 플랫폼 등록(http://localhost)
#      → 제품 설정 → 카카오맵 → 활성화 ON
#      안 켜면 403 "disabled OPEN_MAP_AND_LOCAL service" 가 뜬다.
#   ⚠️ 이 키가 없으면 데이트 코스는 발동하지 않는다. LLM 이 장소를 지어내면
#      존재하지 않는 가게와 죽은 링크가 화면에 뜨기 때문에 일부러 막아뒀다.
KAKAO_REST_API_KEY=

# 유튜브 영상 추천 — YouTube Data API v3
#   https://console.cloud.google.com → API 및 서비스 → YouTube Data API v3 사용 설정 → API 키
#   무료 할당량 하루 10,000 units. search.list 가 호출당 100 units 라
#   추천 1건에 약 105 units → 하루 약 95회. 개발 중 반복 실행에 주의.
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# HTTP 서버 (`worker/api.py`) — 전부 선택. 없으면 아래 기본값
# ---------------------------------------------------------------------------

# 수신 포트. 배포 플랫폼(Railway 등)이 주입한다.
PORT=8000

# 분석 마감. 서버 쪽 요구가 "30초 이내"라 그 앞에서 우리가 끊고
# 규격서 13장의 ANALYSIS_TIMEOUT 을 담은 정상 응답을 보낸다. 실측 최장은 11.3초.
KAKAPO_DEADLINE=25

# 기억 저장소 파킹(2026-09-13) 뒤로 효과 없음. 호환용으로만 남김
KAKAPO_PERSIST=1

# 유튜브 억제의 시간 백스톱(분). 주 억제는 "같은 화제엔 영상 하나만"(세그먼트 기준)이고,
# 이 값은 세그먼트 경계가 흔들릴 때의 검색 폭주를 분당 상한으로 누른다.
# 백엔드가 메시지 1건마다 워커를 부르므로, 억제가 없으면 대화 한 번에 하루 쿼터가 마른다.
# 근거는 요청의 recentResults[].createdAt — 서버가 안 보내면 억제도 안 걸린다.
# ⚠️ 시연 리허설을 연달아 돌리려면 0 으로 둔다 — 세그먼트 억제와 백스톱이 둘 다 꺼진다.
KAKAPO_YOUTUBE_COOLDOWN_MIN=5

# ---------------------------------------------------------------------------
# 레이턴시 손잡이 (2026-09-13, docs/refactoring.md) — 전부 선택. 없으면 아래 기본값
# ---------------------------------------------------------------------------

# 분절 점수 캐시 크기(항목 수). 같은 방의 같은 발화를 요청마다 다시 채점하지 않는다.
# 0 이면 끈다 (회귀 비교·벤치용). 4000 = 방 130개 × 창 30개.
KAKAPO_SEGMENT_CACHE=4000

# 캐시가 있어도 마지막 이 개수는 다시 채점한다. 1 이면 case2 경계를, 5 면 case19 경계를 잃는다 (실측).
KAKAPO_SEGMENT_TAIL=3

# LLM 호출 하나의 HTTP 타임아웃(초). 없으면 SDK 기본 600초라 연결이 멎으면 워커 마감(25초)
# 까지 통째로 기다린다. 여기서 끊으면 그 단계만 폴백으로 떨어지고 나머지는 산다.
KAKAPO_LLM_TIMEOUT=15

# OpenAI 처리 우선순위. 비우면 기본. `priority` 는 지연이 줄지만 토큰 단가가 오른다 —
# 시연·피크 시간에만 켜는 손잡이. 실측은 docs/refactoring.md.
# KAKAPO_SERVICE_TIER=priority

# 묶을 주소를 강제한다. 비워두면 IPv4·IPv6 를 같이 받는 듀얼스택 소켓을 만든다.
# ⚠️ Railway 사설망은 IPv6 전용이라 0.0.0.0 을 넣으면 내부 통신이 끊긴다.
# HOST=
